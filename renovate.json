{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>tjwise99/wise-renovate#feat/onboard-meta-wisekiosk"],
  "packageRules": [
    {
      "description": "Only the Actions uses: lines keep the preset's automerge, since CI runs them; CI never builds the image, so a green check says nothing about any other pin. Keyed on the manager, which every dependency has: a regex dependency has no depType, and a negated depType matcher skips it.",
      "matchManagers": ["!github-actions"],
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["!action"],
      "automerge": false
    },
    {
      "description": "A git-refs commit carries no release timestamp, so the preset's release-age wait would hold these forever.",
      "matchDatasources": ["git-refs"],
      "minimumReleaseAge": null
    },
    {
      "description": "kas-container and the kas image cve-scan.py unpacks with are one tool at one version; the image has no release timestamp, so both skip the release-age wait and move together.",
      "matchPackageNames": ["siemens/kas", "ghcr.io/siemens/kas/kas"],
      "groupName": "kas",
      "minimumReleaseAge": null
    },
    {
      "description": "Its own branch, so its digest pin never shares one with the Actions pins that automerge.",
      "matchPackageNames": ["anchore/grype"],
      "groupName": "grype"
    },
    {
      "description": "Neither registry returns a release timestamp, so the preset's release-age wait would hold these forever.",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "minimumReleaseAge": null
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "kas layer pins. An entry naming no branch inherits defaults.repos.branch in includes/base.yaml; the template's fallback is that value, and tools/ci-guards.sh holds the two equal.",
      "managerFilePatterns": ["/^includes/.+\\.ya?ml$/"],
      "matchStrings": [
        "\\n  (?<depName>[a-z0-9-]+):\\n(?: {4}.*\\n)*? {4}url: [\"']?(?<packageName>[^\"'\\s]+)[\"']?\\n(?: {4}.*\\n)*?(?: {4}branch: (?<branchBefore>\\S+)\\n(?: {4}.*\\n)*?)? {4}commit: (?<currentDigest>[0-9a-f]{40})\\n(?:(?: {4}.*\\n)*? {4}branch: (?<branchAfter>\\S+))?"
      ],
      "currentValueTemplate": "{{#if branchBefore}}{{branchBefore}}{{else if branchAfter}}{{branchAfter}}{{else}}scarthgap{{/if}}",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "The WiseKiosk app commit, following its branch.",
      "managerFilePatterns": ["/^meta-wisekiosk/recipes-wisekiosk/wisekiosk/wisekiosk-src\\.inc$/"],
      "matchStrings": [
        "SRC_URI = \"git://(?<host>[^/]+)/(?<depName>[^;]+?)\\.git;protocol=https;branch=(?<currentValue>[^\";]+)\"\\nSRCREV = \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "packageNameTemplate": "https://{{host}}/{{depName}}.git",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "Release tarballs the workflows install by version.",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "VER=(?<currentValue>\\d+\\.\\d+\\.\\d+)\\n\\s*curl -sSfL \"https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": ["raw\\.githubusercontent\\.com/(?<depName>siemens/kas)/(?<currentValue>[0-9.]+)/kas-container"],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^tools/cve-scan\\.py$/"],
      "matchStrings": [
        "\"(?<depName>anchore/grype|ghcr\\.io/siemens/kas/kas):(?<currentValue>[^\"@]+)(?:@(?<currentDigest>sha256:[0-9a-f]{64}))?\""
      ],
      "autoReplaceStringTemplate": "\"{{depName}}:{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}\"",
      "datasourceTemplate": "docker"
    }
  ]
}
