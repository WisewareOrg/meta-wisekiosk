# Copy to ~/.config/wisekiosk/secrets.yaml and fill in (docs/device.md §"Provisioning"). This
# tracked template keeps every value empty.
header:
  version: 20

# Block names stay unique against kiosk-zero-w.yaml: kas discards a duplicate block in silence.
local_conf_header:
  wifi: |
    WIFI_SSID = ""
    WIFI_PSK_HASH = ""

  device: |
    # Optional. Unset, tools/provision.sh writes no KIOSK_URL line, and
    # kiosk.service's own localhost default applies.
    KIOSK_URL = ""
    KIOSK_HOSTNAME = ""
    MIRROR_HOST = ""

    # 32 lowercase hex characters, unique per board: `systemd-id128 new`, or the board's own
    # /etc/machine-id to keep its journal.
    KIOSK_MACHINE_ID = ""

    # Space-separated; one "nameserver" line per entry in /data/config/resolv.conf.
    KIOSK_NAMESERVER = ""

  # Uncomment only with a real cache server; a placeholder host is looked up on every fetch.
  sourcecontrol: |
    # SOURCE_MIRROR_URL ?= "http://<cache_server>.tld/sources/"
    # SSTATE_MIRRORS ?= "file://.* http://<cache_server>.tld/sstate/PATH;downloadfilename=PATH"
