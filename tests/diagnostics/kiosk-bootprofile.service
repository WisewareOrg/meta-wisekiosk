[Unit]
Description=Boot CPU and disk-I/O sampler (diagnostic; not part of the kiosk)
DefaultDependencies=no
Before=local-fs-pre.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=simple
ExecStart=/usr/local/bin/kiosk-bootprof 150 500 /data/boot-cpu-io mmcblk0
ExecStopPost=/bin/sh -c 'systemctl disable --no-reload kiosk-bootprofile; rm -f /usr/local/bin/kiosk-bootprof /etc/systemd/system/kiosk-bootprofile.service; rmdir /usr/local/bin /usr/local'
IOSchedulingClass=idle

[Install]
WantedBy=sysinit.target
