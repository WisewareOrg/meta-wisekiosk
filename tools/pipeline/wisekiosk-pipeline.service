# #119 D-K. User unit, triggered by wisekiosk-pipeline.timer -- never
# enabled directly. `just pipeline-install` symlinks this (and the timer)
# into ~/.config/systemd/user/.
[Unit]
Description=Bench pipeline: one build / OTA / testimage / rollback / status run

[Service]
Type=oneshot
WorkingDirectory=%h/wisekiosk-pipeline/driver
EnvironmentFile=%h/.config/wisekiosk/pipeline.env
ExecStart=%h/wisekiosk-pipeline/driver/tools/pipeline/run.sh
