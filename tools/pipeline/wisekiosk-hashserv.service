[Unit]
Description=Hash-equivalence server shared by this tree and the pipeline

[Service]
Type=simple
EnvironmentFile=%h/.config/wisekiosk/pipeline.env
# Requires bitbake-hashserv to exist before starting; it creates its own
# schema on an absent database.
ExecStartPre=/bin/sh -c 'test -x "$PIPELINE_DEV_ROOT/sources/poky/bitbake/bin/bitbake-hashserv"'
ExecStart=/bin/sh -c 'exec "$PIPELINE_DEV_ROOT/sources/poky/bitbake/bin/bitbake-hashserv" --bind "unix://$PIPELINE_HASHSERV" --database "$PIPELINE_HASHSERV_DB"'
Restart=on-failure

[Install]
WantedBy=default.target
