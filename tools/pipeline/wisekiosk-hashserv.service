[Unit]
Description=Hash-equivalence server shared by this tree and the pipeline

[Service]
Type=simple
EnvironmentFile=%h/.config/wisekiosk/pipeline.env
ExecStart=/bin/sh -c 'mkdir -p "$(dirname "$PIPELINE_HASHSERV")" "$PIPELINE_DEV_ROOT/build/cache" && exec "$PIPELINE_DEV_ROOT/sources/poky/bitbake/bin/bitbake-hashserv" --bind "unix://$PIPELINE_HASHSERV" --database "$PIPELINE_DEV_ROOT/build/cache/hashserv.db"'
Restart=on-failure

[Install]
WantedBy=default.target
