From 0e0aed2f8d91e621ae792c568390abdf8bbf8b6c Mon Sep 17 00:00:00 2001
From: Wise <47094117+tjwise99@users.noreply.github.com>
Date: Sun, 4 Oct 2026 18:24:03 -0400
Subject: [PATCH] launcher: add --user-script option

Evaluates the script at PATH in the main frame each time a load
finishes (WEBKIT_LOAD_FINISHED), reading the file at that point, and
prints each title change to stdout as "TITLE <title>". A missing or
unreadable file is a warning for that load and the page runs without it.

cog exposes no way to run a script from the command line or a config
file, and cog_launcher_create_view() is the only place the web view is
reachable to hook its load events, so this cannot be expressed from a
bbappend. Suitable for upstream as an option; the title print is kiosk
measurement plumbing and would likely be dropped there.

Upstream-Status: Inappropriate [kiosk measurement channel; the option alone could be submitted]
---
 launcher/cog-launcher.c | 33 +++++++++++++++++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/launcher/cog-launcher.c b/launcher/cog-launcher.c
index e431b55..0af049b 100644
--- a/launcher/cog-launcher.c
+++ b/launcher/cog-launcher.c
@@ -47,6 +47,7 @@ static struct {
         char                    *filter_path;
         WebKitUserContentFilter *filter;
     };
+    char *user_script;
     union {
         char                       *action_name;
         enum webprocess_fail_action action_id;
@@ -263,6 +264,28 @@ on_web_view_create(WebKitWebView *web_view, WebKitNavigationAction *action)
     return NULL;
 }
 
+static void
+on_title_changed(WebKitWebView *web_view)
+{
+    g_print("TITLE %s\n", webkit_web_view_get_title(web_view) ?: "");
+    fflush(stdout);
+}
+
+static void
+on_load_changed_run_user_script(WebKitWebView *web_view, WebKitLoadEvent event, const char *path)
+{
+    if (event != WEBKIT_LOAD_FINISHED)
+        return;
+
+    g_autofree char  *source = NULL;
+    g_autoptr(GError) error = NULL;
+    if (!g_file_get_contents(path, &source, NULL, &error)) {
+        g_warning("Cannot read user script %s: %s", path, error->message);
+        return;
+    }
+    webkit_web_view_evaluate_javascript(web_view, source, -1, NULL, NULL, NULL, NULL, NULL);
+}
+
 static WebKitWebView *
 cog_launcher_create_view(CogLauncher *self, CogShell *shell)
 {
@@ -312,6 +335,12 @@ cog_launcher_create_view(CogLauncher *self, CogShell *shell)
         g_clear_pointer(&s_options.filter, webkit_user_content_filter_unref);
     }
 
+    if (s_options.user_script) {
+        g_signal_connect(web_view, "load-changed", G_CALLBACK(on_load_changed_run_user_script),
+                         s_options.user_script);
+        g_signal_connect(web_view, "notify::title", G_CALLBACK(on_title_changed), NULL);
+    }
+
     g_signal_connect(web_view, "create", G_CALLBACK(on_web_view_create), NULL);
 
     if (platform) {
@@ -1206,6 +1235,10 @@ static GOptionEntry s_cli_options[] = {
      "Ignore TLS errors (default: disabled).", NULL},
     {"content-filter", 'F', 0, G_OPTION_ARG_FILENAME, &s_options.filter_path,
      "Path to content filter JSON rule set (default: none).", "PATH"},
+    {"user-script", '\0', 0, G_OPTION_ARG_FILENAME, &s_options.user_script,
+     "Evaluate the script at PATH in the main frame each time a load finishes, and print each title "
+     "change to stdout (default: none).",
+     "PATH"},
 #if !COG_USE_WPE2
     {"enable-sandbox", 's', 0, G_OPTION_ARG_NONE, &s_options.enable_sandbox,
      "Enable WebProcess sandbox (default: disabled).", NULL},
