# Compressed in-memory swap. The device size is its uncompressed capacity, as a percentage of RAM.
ZRAM_SIZE_PERCENT=50

# This kernel builds lzo-rle in (CONFIG_CRYPTO_LZO=y) and lz4 as a module; zramctl asked for an
# algorithm behind an unloaded module fails quietly, leaving no swap.
ZRAM_ALGORITHM=lzo-rle
