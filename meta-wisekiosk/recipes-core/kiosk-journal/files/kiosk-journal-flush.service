[Unit]
Description=Flush the journal to /data once tmpfiles has made the symlink
# A separate unit: After=systemd-tmpfiles-setup.service on systemd-journal-flush makes an ordering
# cycle, and systemd breaks it by dropping the tmpfiles-setup job.
After=systemd-tmpfiles-setup.service systemd-journald.service
Wants=systemd-journald.service
RequiresMountsFor=/data

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/journalctl --flush

[Install]
WantedBy=multi-user.target
