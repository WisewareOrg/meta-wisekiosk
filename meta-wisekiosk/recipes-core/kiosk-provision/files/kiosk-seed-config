#!/bin/sh
# Seed /data/config/config.json from the image's shipped default when none exists. Called by
# kiosk-provision.
#
# ROOT relocates every path, for tests; a real boot leaves it empty. It never fails: an existing
# config.json, even an empty one, is left unchanged, and a missing image default is not an error.

set -u
ROOT="${ROOT:-}"
CFG="$ROOT/data/config"
SRC="$ROOT/usr/share/wisekiosk/config.example.json"
log() { echo "kiosk-seed-config: $*"; }

mkdir -p "$CFG"

if [ ! -e "$CFG/config.json" ]; then
    if [ -s "$SRC" ]; then
        # The image's busybox has no install applet.
        tmp="$CFG/config.json.tmp"
        if ! cp "$SRC" "$tmp"; then
            rm -f "$tmp"
            log "failed to seed /data/config/config.json: cp"
        elif ! chmod 0644 "$tmp"; then
            rm -f "$tmp"
            log "failed to seed /data/config/config.json: chmod"
        elif ! mv "$tmp" "$CFG/config.json"; then
            rm -f "$tmp"
            log "failed to seed /data/config/config.json: mv"
        else
            log "seeded /data/config/config.json from the image default"
        fi
    else
        log "no image default config to seed"
    fi
fi

exit 0
