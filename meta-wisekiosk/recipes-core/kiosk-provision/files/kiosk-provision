#!/bin/sh
# Apply the per-device configuration that cannot be read from /data in place,
# and report provisioning state.
#
# wpa_supplicant, kiosk.service and /etc/resolv.conf read /data/config directly. This script
# handles what they cannot:
#   hostname   -- set into the kernel from /data/config/hostname
#   machine-id -- journald reads it before /data is mounted, so the RAUC slot-post-install hook
#                 writes it into the rootfs; this script only seeds /data/etc/machine-id from
#                 the rootfs on a device that has none.
#   config.json -- kiosk-seed-config seeds /data/config/config.json from the image default, only
#                 when none exists.
#
# It never fails the boot; an unprovisioned device is reported in the journal.

set -u
CFG=/data/config
log() { echo "kiosk-provision: $*"; }

missing=0
for f in wpa_supplicant.conf kiosk.conf resolv.conf; do
    if [ -s "$CFG/$f" ]; then
        log "ok      $CFG/$f"
    else
        log "MISSING $CFG/$f"
        missing=$((missing + 1))
    fi
done
[ "$missing" -gt 0 ] && log "UNPROVISIONED: $missing file(s) absent -- expect no network and no kiosk"

if [ -s "$CFG/hostname" ]; then
    h=$(head -n 1 "$CFG/hostname" | tr -d '[:space:]')
    if [ -n "$h" ]; then
        printf '%s\n' "$h" > /etc/hostname
        hostname "$h" 2>/dev/null
        log "hostname $h"
    fi
fi

# Seed /data with this rootfs's machine-id if it has one and /data does not, so
# the RAUC hook has something to carry forward on the next update.
if [ ! -s /data/etc/machine-id ] && [ -s /etc/machine-id ]; then
    mkdir -p /data/etc
    cp /etc/machine-id /data/etc/machine-id
    log "seeded /data/etc/machine-id"
fi

kiosk-seed-config

exit 0
