[Unit]
Description=Apply per-site configuration from /data
DefaultDependencies=no
# Orders after /data and before the consumers of /data/config.
After=data.mount
Requires=data.mount
Before=wpa_supplicant.service systemd-timesyncd.service kiosk.service network-pre.target
ConditionPathIsMountPoint=/data

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/kiosk-provision

[Install]
WantedBy=sysinit.target
