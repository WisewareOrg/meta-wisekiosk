[Unit]
Description=Kiosk browser: WPE WebKit on DRM, no display server
After=network-online.target data.mount
Wants=network-online.target
Requires=data.mount

[Service]
Type=simple
# The default target is the local app, served by wisekiosk.service. systemd
# applies these in file order, so a provisioned kiosk.conf overrides it; the
# leading dash makes the file optional.
Environment=KIOSK_URL=http://localhost:8080
# WEBKIT_INSPECTOR_HTTP_SERVER=127.0.0.1:2999 in it turns the remote inspector on.
EnvironmentFile=-/data/config/kiosk.conf
ExecStart=/usr/bin/kiosk-browser $KIOSK_URL
Restart=always
RestartSec=10
# The page answers every 5 s; see kiosk-browser.c.
WatchdogSec=30

[Install]
WantedBy=multi-user.target
