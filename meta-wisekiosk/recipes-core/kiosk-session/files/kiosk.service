[Unit]
Description=Kiosk browser: WPE WebKit on DRM, no display server
After=network-online.target data.mount
Wants=network-online.target
Requires=data.mount

[Service]
Type=simple
# The default target is the local app, served by wisekiosk.service. A provisioned kiosk.conf
# overrides these, as EnvironmentFile settings override Environment=; the leading dash makes the
# file optional. WEBKIT_INSPECTOR_HTTP_SERVER=127.0.0.1:2999 in it turns the remote inspector on.
Environment=KIOSK_URL=http://localhost:8080
# A display that cannot be opened aborts the browser with the reason, rather than leaving it without a view.
Environment=WPE_PLATFORM=drm
EnvironmentFile=-/data/config/kiosk.conf
ExecStart=/usr/bin/kiosk-browser $KIOSK_URL
# Always, because kiosk-browser exits 0 on a console switch.
Restart=always
RestartSec=10
# PERIOD in kiosk-browser.c is how often the page is asked.
WatchdogSec=30

[Install]
WantedBy=multi-user.target
