[Unit]
Description=Kiosk browser: wpe-kiosk on WPE WebKit, straight to DRM, no display server
After=network-online.target data.mount
Wants=network-online.target
Requires=data.mount

[Service]
Type=simple
# The default target is the local app, served by wisekiosk.service. systemd
# applies these in file order, so a provisioned kiosk.conf overrides it; the
# leading dash makes the file optional.
Environment=KIOSK_URL=http://localhost:8080
EnvironmentFile=-/data/config/kiosk.conf
ExecStart=/usr/bin/kiosk-launch
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
