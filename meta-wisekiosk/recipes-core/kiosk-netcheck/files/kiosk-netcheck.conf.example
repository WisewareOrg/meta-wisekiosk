# Format of /data/kiosk-netcheck.conf, which kiosk-netcheck sources at runtime. This file is not
# installed or read on a device; the script's source directive points the linter at it.
# It carries no shebang and a .example name so shellcheck does not treat it as a script.
#
# Sourced by a /bin/sh script: plain NAME=value assignments only. Each value below is the script's
# default.

# Seconds to wait for a usable LAN before good-marking is withheld.
DEADLINE=120

# Interface whose default route names the gateway to ping.
IFACE=wlan0

# Ping this host instead of the interface's default gateway. Empty is the normal
# case and means "take the gateway from the route table". Pointing it at an
# unroutable address fails the check while the real network stays up.
TARGET=
