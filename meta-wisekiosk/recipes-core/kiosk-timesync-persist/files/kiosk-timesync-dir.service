[Unit]
Description=Stage the persistent timesync clock dir on /data
# Creates and chowns /data/systemd-timesync, the BindPaths source in 10-persist-clock.conf. Not
# RemainAfterExit: the drop-in's Wants= re-runs it at every timesyncd start. No Requires=, so a
# failed /data does not cancel NTP.
DefaultDependencies=no
After=data.mount
Before=systemd-timesyncd.service
# No start limit: the default would stop staging after a timesyncd crash loop.
StartLimitIntervalSec=0

[Service]
Type=oneshot
# A mkdir failure short-circuits chown, so the unit cannot exit 0 with the dir root-owned. chown -R
# also re-owns the clock file.
ExecStart=/bin/sh -c 'mkdir -p /data/systemd-timesync && exec chown -R systemd-timesync:systemd-timesync /data/systemd-timesync'

[Install]
WantedBy=sysinit.target
