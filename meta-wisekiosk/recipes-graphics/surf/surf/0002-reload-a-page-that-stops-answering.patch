 void
+armpagewatch(Client *c)
+{
+	if (!pagedeadline)
+		return;
+	c->armed = 1;
+	c->pingsent = 0;
+	c->pingseq++;
+	if (!c->pingcancel)
+		c->pingcancel = g_cancellable_new();
+	if (!c->pagetimer)
+		c->pagetimer = g_timeout_add_seconds(PAGETICK, pagetick, c);
+}
+
+gboolean
+pagetick(gpointer p)
+{
+	Client *c = p;
+	Ping *pg;
+	gint64 now;
+
+	if (!c->armed)
+		return TRUE;
+
+	now = g_get_monotonic_time();
+	if (c->pingsent) {
+		if (now - c->pingsent >= (gint64)pagedeadline * G_USEC_PER_SEC) {
+			fprintf(stderr, "surf: page did not answer for %d s, "
+			        "reloading it\n",
+			        (int)((now - c->pingsent) / G_USEC_PER_SEC));
+			fflush(stderr);
+			c->armed = 0;
+			c->pingsent = 0;
+			c->pingseq++;
+			webkit_web_view_terminate_web_process(c->view);
+		}
+		return TRUE;
+	}
+
+	pg = g_new(Ping, 1);
+	pg->c = c;
+	pg->seq = ++c->pingseq;
+	c->pingsent = now;
+	webkit_web_view_evaluate_javascript(c->view, "0", -1, NULL, NULL,
+	                                    c->pingcancel, pagepingdone, pg);
+	return TRUE;
+}
+
+void
+pagepingdone(GObject *src, GAsyncResult *res, gpointer p)
+{
+	Ping *pg = p;
+	GError *err = NULL;
+	JSCValue *v;
+	gboolean cancelled;
+
+	v = webkit_web_view_evaluate_javascript_finish(WEBKIT_WEB_VIEW(src),
+	                                               res, &err);
+	cancelled = err && g_error_matches(err, G_IO_ERROR,
+	                                   G_IO_ERROR_CANCELLED);
+	/* Any completion is an answer, a script error included: the process
+	 * replied. A cancelled one means the client may be gone, so it must not
+	 * be touched. An older question's answer must not clear the current. */
+	if (!cancelled && pg->seq == pg->c->pingseq)
+		pg->c->pingsent = 0;
+	if (v)
+		g_object_unref(v);
+	g_clear_error(&err);
+	g_free(pg);
+}
+
+/* Brings the configured page back: loads the launch URI, whatever the view
+ * shows now, in the view's web process, starting a fresh one if it has none. */
+gboolean
+bringpageback(gpointer p)
+{
+	Client *c;
+
+	for (c = clients; c && c != p; c = c->next)
+		;
+	if (c && launchuri)
+		webkit_web_view_load_uri(c->view, launchuri);
+	return G_SOURCE_REMOVE;
+}
