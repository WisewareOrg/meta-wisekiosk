+
+/* Retries a failed main-frame load: one stderr line per streak of failures,
+ * and at most one retry pending. WebKit's error page stays up meanwhile. */
+gboolean
+loadfailed(WebKitWebView *v, WebKitLoadEvent e, gchar *uri, GError *err,
+           Client *c)
+{
+	/* The errors webkitWebViewLoadFail (WebKitWebView.cpp, WebKitGTK 2.44.3)
+	 * shows no error page for: each leaves the previous page or a handler in
+	 * place. Its media error is the 2022 API's name for the plugin one. */
+	if (g_error_matches(err, WEBKIT_NETWORK_ERROR,
+	                    WEBKIT_NETWORK_ERROR_CANCELLED) ||
+	    g_error_matches(err, WEBKIT_PLUGIN_ERROR,
+	                    WEBKIT_PLUGIN_ERROR_WILL_HANDLE_LOAD) ||
+	    g_error_matches(err, WEBKIT_POLICY_ERROR,
+	        WEBKIT_POLICY_ERROR_FRAME_LOAD_INTERRUPTED_BY_POLICY_CHANGE))
+		return FALSE;
+
+	if (!c->failstreak) {
+		fprintf(stderr, "surf: load of %s failed: %s, "
+		        "retrying every %d s\n", uri, err->message, PAGETICK);
+		fflush(stderr);
+		c->failstreak = 1;
+	}
+	c->loadfailed = 1;
+	c->failpage = 1;
+	if (!c->retrytimer)
+		c->retrytimer = g_timeout_add_seconds(PAGETICK, retryload, c);
+	return FALSE;
+}
+
+/* Loads the launch argument again, unless a load started since the failure. */
+gboolean
+retryload(gpointer p)
+{
+	Client *c = p;
+
+	c->retrytimer = 0;
+	if (c->loadfailed)
+		bringpageback(c);
 	return G_SOURCE_REMOVE;
 }
 
