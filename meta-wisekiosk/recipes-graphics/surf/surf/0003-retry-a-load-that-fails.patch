+/* Retries a failed main-frame load: one stderr line per streak of failures,
+ * and at most one retry pending. WebKit's error page stays up meanwhile. A
+ * cancelled load was superseded by another and is not a failure. */
+gboolean
+loadfailed(WebKitWebView *v, WebKitLoadEvent e, gchar *uri, GError *err,
+           Client *c)
+{
+	if (g_error_matches(err, WEBKIT_NETWORK_ERROR,
+	                    WEBKIT_NETWORK_ERROR_CANCELLED))
+		return FALSE;
+
+	if (!c->failstreak) {
+		fprintf(stderr, "surf: load of %s failed: %s, "
+		        "retrying every %d s\n", uri, err->message, PAGETICK);
+		fflush(stderr);
+		c->failstreak = 1;
+	}
+	c->loadfailed = 1;
+	c->failpage = 1;
+	if (!c->retrytimer)
+		c->retrytimer = g_timeout_add_seconds(PAGETICK, retryload, c);
+	return FALSE;
+}
+
+/* Loads the launch argument again, unless a load started since the failure. */
+gboolean
+retryload(gpointer p)
+{
+	Client *c = p;
+
+	c->retrytimer = 0;
+	if (c->loadfailed)
+		bringpageback(c);
+	return G_SOURCE_REMOVE;
+}
