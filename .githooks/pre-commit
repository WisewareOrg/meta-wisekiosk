#!/bin/sh
# Runs the global gitleaks hook and the identity scan. Install with: just install-hooks
rc=0

# Uses the repo .venv python when present, else python3.
py=python3
[ -x ".venv/bin/python3" ] && py="$PWD/.venv/bin/python3"

# This repo's core.hooksPath overrides the global one, so the global gitleaks pre-commit is run
# explicitly; an armed global hook that is missing fails the commit.
global_dir=$(git config --global core.hooksPath 2>/dev/null)
# The tilde is escaped: an unescaped one in a case pattern is tilde-expanded.
case "$global_dir" in
    \~/*) global_dir="$HOME/${global_dir#\~/}" ;;
    \~)   global_dir="$HOME" ;;
esac
if [ -n "$global_dir" ]; then
    if [ -x "$global_dir/pre-commit" ]; then
        "$global_dir/pre-commit" || rc=1
    else
        echo "pre-commit: global hook armed at $global_dir but no runnable pre-commit there" >&2
        rc=1
    fi
fi

"$py" tools/scrub-identity.py --check || rc=1
exit $rc
